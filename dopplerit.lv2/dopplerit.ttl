@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/pilali/dopplerit>
    a lv2:Plugin , lv2:DelayPlugin , doap:Project ;
    doap:name "DopplerIt" ;
    doap:license <https://spdx.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "pilali" ;
        foaf:homepage <https://github.com/pilali/dopplerit> ;
    ] ;
    mod:brand "pilali" ;
    mod:label "DopplerIt" ;
    lv2:minorVersion 2 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Doppler delay: an echo with 1 to 4 heads in series, like a multi-head tape delay, where every head applies a Doppler pass-by to what it reads, like the siren of a passing emergency vehicle. Each LFO cycle is one vehicle: the repeats go from the arrival pitch (higher) to the departure pitch (lower), then jump straight back to the arrival of the next vehicle. The transposition compounds from head to head. Mono input; Output Mono gives the same signal on both outputs, Output Stereo slightly offsets the effect between left and right." ;
    lv2:port
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R" ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "heads" ;
        lv2:name "Heads" ;
        lv2:default 2 ;
        lv2:minimum 1 ;
        lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "1 head" ; rdf:value 1 ] ,
                       [ rdfs:label "2 heads" ; rdf:value 2 ] ,
                       [ rdfs:label "3 heads" ; rdf:value 3 ] ,
                       [ rdfs:label "4 heads" ; rdf:value 4 ] ;
        rdfs:comment "Number of heads in series. Each head delays the previous one by Time and applies the Doppler pass-by again: the transposition compounds from head to head." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "time" ;
        lv2:name "Time" ;
        lv2:default 0.25 ;
        lv2:minimum 0.02 ;
        lv2:maximum 1.5 ;
        lv2:portProperty pprops:logarithmic , mod:tempoRelatedDynamicScalePoints ;
        units:unit units:s ;
        rdfs:comment "Delay between two heads (same for every head). Can be synced to the tempo in mod-ui." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "speed" ;
        lv2:name "Speed" ;
        lv2:default 100.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 300.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit [
            a units:Unit ;
            rdfs:label "kilometers per hour" ;
            units:symbol "km/h" ;
            units:render "%.0f km/h"
        ] ;
        rdfs:comment "Speed of the vehicle: amount of transposition (about +/- 1.4 semitone per head at 100 km/h)." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "distance" ;
        lv2:name "Distance" ;
        lv2:default 5.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 50.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit units:m ;
        rdfs:comment "Closest distance of the pass-by: short = abrupt pitch drop, long = smooth glide." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "period" ;
        lv2:name "Period" ;
        lv2:default 2.5 ;
        lv2:minimum 0.1 ;
        lv2:maximum 16.0 ;
        lv2:portProperty pprops:logarithmic , mod:tempoRelatedDynamicScalePoints ;
        units:unit units:s ;
        rdfs:comment "Time between two vehicles (one LFO cycle). Can be synced to the tempo in mod-ui." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "stagger" ;
        lv2:name "Stagger" ;
        lv2:default 0.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "0 %: all heads pass in sync (the effect compounds). Higher: each head passes later than the previous one (several vehicles following each other); 100 / number of heads spreads them evenly." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 35.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Amount of the last head sent back to the first one." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "tone" ;
        lv2:name "Tone" ;
        lv2:default 60.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Low-pass in every head: each repeat gets darker, like an analog delay." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "mix" ;
        lv2:name "Dry/Wet" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Dry/wet balance. Both signals are at full level at 50 %." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "output" ;
        lv2:name "Output" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Mono" ; rdf:value 0 ] ,
                       [ rdfs:label "Stereo" ; rdf:value 1 ] ;
        rdfs:comment "Mono: same signal on both outputs (connect either one). Stereo: the effect is slightly offset between left and right." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "loop" ;
        lv2:name "Loop" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled ;
        rdfs:comment "On: vehicles pass continuously. Off: one pass-by per trigger." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ;
        lv2:symbol "trigger" ;
        lv2:name "Trigger" ;
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:toggled , pprops:trigger ;
        rdfs:comment "Start a pass-by from the beginning (assign it to a footswitch)." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:integer , lv2:toggled ;
    ] .
