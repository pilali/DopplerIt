@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix mod:    <http://moddevices.com/ns/mod#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<https://github.com/pilali/dopplerit>
    a lv2:Plugin , lv2:DelayPlugin , doap:Project ;
    doap:name "DopplerIt" ;
    doap:license <https://spdx.org/licenses/MIT> ;
    doap:maintainer [
        foaf:name "pilali" ;
        foaf:homepage <https://github.com/pilali/dopplerit> ;
    ] ;
    mod:brand "pilali" ;
    mod:label "DopplerIt" ;
    lv2:minorVersion 4 ;
    lv2:microVersion 0 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    rdfs:comment "Doppler delay: every sound that enters lives its own pass-by while it echoes away. The pitch of a repeat depends only on its age, like a delay whose repeats come from a passing siren: the first repeats arrive higher, the later ones leave lower (Pass-by), or only one half of it (Approach, Recede). Speed and Depth set the transposition (up to one octave each way), Shape the part of the pass taken by the glide, Period its duration. Mono input; Output Mono gives the same signal on both outputs, Output Stereo slightly offsets the effect between left and right." ;
    lv2:port
    [
        a lv2:InputPort , lv2:AudioPort ;
        lv2:index 0 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 1 ;
        lv2:symbol "out_l" ;
        lv2:name "Out L" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 2 ;
        lv2:symbol "out_r" ;
        lv2:name "Out R" ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "mode" ;
        lv2:name "Mode" ;
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Approach" ; rdf:value 0 ] ,
                       [ rdfs:label "Recede" ; rdf:value 1 ] ,
                       [ rdfs:label "Pass-by" ; rdf:value 2 ] ;
        rdfs:comment "Pass-by: the repeats go from the arrival pitch (higher) to the departure pitch (lower). Approach: arrival only, back to the original pitch. Recede: departure only, from the original pitch." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "time" ;
        lv2:name "Time" ;
        lv2:default 0.25 ;
        lv2:minimum 0.02 ;
        lv2:maximum 1.5 ;
        lv2:portProperty pprops:logarithmic , mod:tempoRelatedDynamicScalePoints ;
        units:unit units:s ;
        rdfs:comment "Delay between two repeats. Short = dense repeats, the pitch steps blend into a glide. Can be synced to the tempo in mod-ui." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "speed" ;
        lv2:name "Speed" ;
        lv2:default 100.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 300.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit [
            a units:Unit ;
            rdfs:label "kilometers per hour" ;
            units:symbol "km/h" ;
            units:render "%.0f km/h"
        ] ;
        rdfs:comment "Speed of the vehicle: amount of transposition (realistic: about +/- 1.4 semitone at 100 km/h)." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "depth" ;
        lv2:name "Depth" ;
        lv2:default 2.0 ;
        lv2:minimum 1.0 ;
        lv2:maximum 8.0 ;
        lv2:portProperty pprops:logarithmic ;
        units:unit [
            a units:Unit ;
            rdfs:label "times" ;
            units:symbol "x" ;
            units:render "x%.1f"
        ] ;
        rdfs:comment "Exaggeration of the transposition: x1 = realistic, up to one octave each way." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ;
        lv2:symbol "shape" ;
        lv2:name "Shape" ;
        lv2:default 50.0 ;
        lv2:minimum 5.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Part of the pass taken by the pitch glide, whatever the speed: 5 % = quick swap at the closest point, 100 % = slow glide over the whole pass." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ;
        lv2:symbol "period" ;
        lv2:name "Period" ;
        lv2:default 2.0 ;
        lv2:minimum 0.1 ;
        lv2:maximum 16.0 ;
        lv2:portProperty pprops:logarithmic , mod:tempoRelatedDynamicScalePoints ;
        units:unit units:s ;
        rdfs:comment "Duration of the pass, in age of the repeats (at most 24 repeats). After it, the repeats keep the final pitch until they fade. Can be synced to the tempo in mod-ui." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ;
        lv2:symbol "feedback" ;
        lv2:name "Feedback" ;
        lv2:default 70.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Level of each repeat relative to the previous one." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ;
        lv2:symbol "tone" ;
        lv2:name "Tone" ;
        lv2:default 60.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Low-pass on the repeats: each repeat gets darker, like an analog delay." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ;
        lv2:symbol "mix" ;
        lv2:name "Dry/Wet" ;
        lv2:default 50.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 100.0 ;
        units:unit [
            a units:Unit ;
            rdfs:label "percent" ;
            units:symbol "%" ;
            units:render "%.0f%%"
        ] ;
        rdfs:comment "Dry/wet balance. Both signals are at full level at 50 %." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ;
        lv2:symbol "output" ;
        lv2:name "Output" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Mono" ; rdf:value 0 ] ,
                       [ rdfs:label "Stereo" ; rdf:value 1 ] ;
        rdfs:comment "Mono: same signal on both outputs (connect either one). Stereo: the effect is slightly offset between left and right." ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ;
        lv2:symbol "enabled" ;
        lv2:name "Enabled" ;
        lv2:default 1 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:designation lv2:enabled ;
        lv2:portProperty lv2:integer , lv2:toggled ;
    ] .
